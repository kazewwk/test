          "type": "paragraph_title",
          "bbox": [
            0.24,
            0.759,
            0.25,
            0.768
          ],
          "level": 2,
          "content": "42"
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.769,
            0.295,
            0.781
          ],
          "content": "2 Where is she going?"
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.782,
            0.298,
            0.794
          ],
          "content": "3 What are you eating?"
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.795,
            0.295,
            0.806
          ],
          "content": "4 Why are you crying?"
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.807,
            0.309,
            0.818
          ],
          "content": "5 What are they looking at?"
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.819,
            0.295,
            0.831
          ],
          "content": "6 Why is he laughing?"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.24,
            0.835,
            0.25,
            0.844
          ],
          "level": 2,
          "content": "4.3"
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.846,
            0.305,
            0.857
          ],
          "content": "3. Are you listening to me?"
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.858,
            0.318,
            0.869
          ],
          "content": "4 Where are your friends going?"
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.87,
            0.318,
            0.881
          ],
          "content": "5. Are your parents watching TV?"
