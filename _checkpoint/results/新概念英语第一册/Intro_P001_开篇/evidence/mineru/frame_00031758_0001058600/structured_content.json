          "level": 2,
          "content": "4.1"
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.694,
            0.295,
            0.705
          ],
          "content": "2. Are you going now?"
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.706,
            0.276,
            0.717
          ],
          "content": "3. Is it raining?"
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.718,
            0.31,
            0.729
          ],
          "content": "4. Are you enjoying the film?"
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.73,
            0.299,
            0.741
          ],
          "content": "5 Is that clock working?"
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.742,
            0.309,
            0.754
          ],
          "content": "6 Are you waiting for a bus?"
