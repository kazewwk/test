            0.317,
            0.557
          ],
          "content": "5. It's raining, or It isn't raining, /It's not raining."
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.558,
            0.295,
            0.569
          ],
          "content": "6 I'm learning English."
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.571,
            0.308,
            0.594
          ],
          "content": "7 I'm listening to music. or I'm not listening to music."
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.595,
            0.313,
            0.618
          ],
          "content": "8 The sun is shining, or The sun isn't shining."
        },
        {
          "type": "text",
          "bbox": [
            0.24,
            0.619,
            0.311,
            0.643
          ],
          "content": "9 I'm wearing shoes, or I'm not wearing shoes."
