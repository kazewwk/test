          ],
          "content": "30.2"
        },
        {
          "type": "text",
          "bbox": [
            0.327,
            0.498,
            0.492,
            0.511
          ],
          "content": "Complete these sentences. Use can or can't + one of these verbs:"
        },
        {
          "type": "text",
          "bbox": [
            0.332,
            0.518,
            0.434,
            0.532
          ],
          "content": "come- find hear see speak"
