          "content": [
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "RNA Can Both Store Information and Catalyze Chemical Reactions 391  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "How Did Protein Synthesis Evolve? 392  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "All Present-Day Cells Use DNA as Their Hereditary Material 393  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Summary 393  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Problems 394  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "References 395"
                }
              ]
            }
          ]
        },
        {
