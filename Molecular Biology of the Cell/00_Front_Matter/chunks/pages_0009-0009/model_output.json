        "content": [
          {
            "type": "text",
            "content": "Nomenclature for Genes and Proteins"
          }
        ],
        "lines": [
          {
            "bbox": [
              0.078,
              0.169,
              0.515,
              0.2
            ]
          },
          {
            "bbox": [
              0.081,
              0.208,
              0.304,
