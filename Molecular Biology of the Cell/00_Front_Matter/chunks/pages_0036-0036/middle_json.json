            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "S-Cdk Initiates DNA Replication Once Per Cell Cycle 1043  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Chromosome Duplication Requires Duplication of Chromatin Structure 1045  "
