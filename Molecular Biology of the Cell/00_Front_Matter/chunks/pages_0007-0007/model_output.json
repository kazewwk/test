          0.563
        ],
        "content": [
          {
            "type": "text",
            "content": "• New coverage of evolution, including a new discussion on the diversity of life (Chapter 1), plus updates on both human (Chapter 4) and HIV (Chapter 23) evolution."
          }
        ],
        "lines": [
          {
            "bbox": [
              0.08,
