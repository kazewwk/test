          0.598
        ],
        "content": [
          {
            "type": "text",
            "content": "In addition, a quarter of the book’s illustrations are either completely new or significantly updated for accuracy, clarity, and visual appeal."
          }
        ],
        "lines": [
          {
            "bbox": [
              0.078,
              0.57,
