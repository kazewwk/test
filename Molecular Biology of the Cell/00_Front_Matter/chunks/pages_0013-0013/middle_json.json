          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.076,
            0.253,
            0.625,
            0.328
          ],
          "content": [
            {
              "type": "text",
              "content": "Bruce Alberts",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " received his PhD from Harvard University and is the Chancellor’s Leadership Chair in Biochemistry and Biophysics for Science and Education, University of California, San Francisco. He was the editor-in-chief of Science magazine from 2008 until 2013, and for twelve years he served as president of the U.S. National Academy of Sciences (1993–2005)."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.076,
            0.339,
            0.625,
            0.384
          ],
          "content": [
            {
              "type": "text",
              "content": "Rebecca Heald",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": "  received her PhD from Harvard University and is professor of molecular and cell biology at the University of California, Berkeley. She also serves as the co-chair of that department."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.076,
            0.396,
            0.625,
            0.442
          ],
          "content": [
            {
              "type": "text",
              "content": "Alexander Johnson",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " received his PhD from Harvard University and is professor of microbiology and immunology at the University of California, San Francisco. He is also director of the Program in Biological Sciences (PIBS) at UCSF."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.076,
            0.453,
            0.624,
            0.498
          ],
          "content": [
            {
              "type": "text",
              "content": "David Morgan",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " received his PhD from the University of California, San Francisco, and is professor of the Department of Physiology there as well as vice dean for research in the School of Medicine."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.076,
            0.51,
            0.625,
            0.556
          ],
          "content": [
            {
              "type": "text",
              "content": "Martin Raff",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " received his MD from McGill University and is an emeritus professor of biology and an affiliated member of the Medical Research Council Laboratory for Molecular Cell Biology at University College London."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.076,
            0.568,
            0.624,
            0.613
          ],
          "content": [
            {
              "type": "text",
              "content": "Keith Roberts",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " received his PhD from the University of Cambridge and was deputy director of the John Innes Centre, Norwich. He is emeritus professor at the University of East Anglia."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.076,
            0.625,
            0.624,
            0.684
          ],
          "content": [
            {
              "type": "text",
              "content": "Peter Walter",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " received his PhD from the Rockefeller University in New York and is professor of the Department of Biochemistry and Biophysics at the University of California, San Francisco, and an investigator at the Howard Hughes Medical Institute."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.076,
            0.696,
            0.624,
            0.742
          ],
          "content": [
            {
              "type": "text",
              "content": "John Wilson",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " received his PhD from the California Institute of Technology. He is Distinguished Emeritus Professor of Biochemistry and Molecular Biology at Baylor College of Medicine in Houston."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.076,
            0.753,
            0.625,
            0.813
          ],
          "content": [
            {
              "type": "text",
              "content": "Tim Hunt",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " received his PhD from the University of Cambridge, where he taught biochemistry and cell biology for more than 20 years. He worked at Cancer Research UK from 1990 to 2010. He shared the 2001 Nobel Prize in Physiology or Medicine with Lee Hartwell and Paul Nurse. He moved to Okinawa in 2016."
            }
          ]
        }
