            0.475,
            0.938
          ],
          "content": [
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "THE ENDOPLASMIC RETICULUM 698  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "The ER Is Structurally and Functionally Diverse 698  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Signal Sequences Were First Discovered in Proteins Imported into the Rough ER 701  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "A Signal-Recognition Particle (SRP) Directs the ER Signal Sequence to a Specific Receptor at the ER 702  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "The Polypeptide Chain Passes Through a Signal Sequence-gated Aqueous Channel in the Translocator 705  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Translocation Across the ER Membrane Does Not Always Require Ongoing Polypeptide Chain Elongation 707  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Transmembrane Proteins Contain Hydrophobic Segments That Are Recognized Like Signal Sequences 709  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Hydrophobic Segments of Multipass Transmembrane Proteins Are Interpreted Contextually to Determine Their Orientation 710  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Some Proteins Are Integrated into the ER Membrane by a Post-translational Mechanism 711  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Some Membrane Proteins Acquire a Covalently Attached Glycosylphosphatidylinositol (GPI) Anchor 712  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Translocated Polypeptide Chains Fold and Assemble in the Lumen of the Rough ER 712  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Most Proteins Synthesized in the Rough ER Are Glycosylated by the Addition of a Common N-Linked Oligosaccharide 714  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Oligosaccharides Are Used as Tags to Mark the State of Protein Folding 715  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Improperly Folded Proteins Are Exported from the ER and Degraded in the Cytosol 716  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Misfolded Proteins in the ER Activate an Unfolded Protein Response 717  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "The ER Assembles Most Lipid Bilayers 720  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Membrane Contact Sites Between the ER and Other Organelles Facilitate Selective Lipid Transfer 722  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Summary 723  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "PEROXISOMES 723  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Peroxisomes Use Molecular Oxygen and Hydrogen Peroxide to Perform Oxidation Reactions 724  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Short Signal Sequences Direct the Import of Proteins into Peroxisomes 724  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Summary 726  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "THE TRANSPORT OF PROTEINS INTO MITOCHONDRIA AND CHLOROPLASTS 726  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Translocation into Mitochondria Depends on Signal Sequences and Protein Translocators 727  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Mitochondrial Proteins Are Imported Post-translationally as Unfolded Polypeptide Chains 728  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Protein Import Is Powered by ATP Hydrolysis, a Membrane Potential, and Redox Potential 730  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Transport into the Inner Mitochondrial Membrane Occurs Via Several Routes 731  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Bacteria and Mitochondria Use Similar Mechanisms to Insert "
                },
                {
                  "type": "equation_inline",
                  "content": "\\beta"
                },
                {
                  "type": "text",
                  "content": " Barrels into Their Outer Membrane 733  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Two Signal Sequences Direct Proteins to the Thylakoid Membrane in Chloroplasts 733  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Summary 735  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "THE TRANSPORT OF MOLECULES BETWEEN THE NUCLEUS AND THE CYTOSOL 735  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Nuclear Pore Complexes Perforate the Nuclear Envelope 736  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Nuclear Localization Signals Direct Proteins to the Nucleus 738  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Nuclear Import Receptors Bind to Both Nuclear Localization Signals and NPC Proteins 739  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "The Ran GTPase Imposes Directionality on Nuclear Import Through NPCs 740  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Nuclear Export Works Like Nuclear Import, but in Reverse 741  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Transport Through NPCs Can Be Regulated by Controlling Access to the Transport Machinery 742  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "The Nuclear Envelope Disassembles and Reassemblies During Mitosis 743  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Summary 745  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Problems 746  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "References 748  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Chapter 13 Intracellular Membrane Traffic 749  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "MECHANISMS OF MEMBRANE TRANSPORT AND COMPARTMENT IDENTITY 751  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "There Are Various Types of Coated Vesicles 751"
                }
              ]
            }
          ]
        },
        {
          "type": "index",
          "index": 2,
          "bbox": [
            0.492,
            0.098,
            0.891,
            0.938
          ],
          "content": [
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "The Assembly of a Clathrin Coat Drives Vesicle Formation 752  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Adaptor Proteins Select Cargo into Clathrin-coated Vesicles 753  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Phosphoinositides Mark Organelles and Membrane Domains 754  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Membrane-bending Proteins Help Deform the Membrane During Vesicle Formation 755  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Cytoplasmic Proteins Regulate the Pinching off and Uncoating of Coated Vesicles 756  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Monomeric GTPases Control Coat Assembly 756  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Coat-recruitment GTPases Participate in Coat Disassembly 758  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "The Shape and Size of Transport Vesicles Are Diverse 759  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Rab Proteins Guide Transport Vesicles to Their Target Membrane 760  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Rab Proteins Create and Change the Identity of an Organelle 761  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "SNAREs Mediate Membrane Fusion 762  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Interacting SNAREs Need to Be Pried Apart Before They Can Function Again 763  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Viruses Encode Specialized Membrane Fusion Proteins Needed for Cell Entry 764  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Summary 764  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "TRANSPORT FROM THE ENDOPLASMIC RETICULUM THROUGH THE GOLGI APPARATUS 765  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Proteins Leave the ER in COPII-coated Transport Vesicles 765  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Only Proteins That Are Properly Folded and Assembled Can Leave the ER 766  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Vesicular Tubular Clusters Mediate Transport from the ER to the Golgi Apparatus 766  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "The Retrieval Pathway to the ER Uses Sorting Signals 768  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Many Proteins Are Selectively Retained in the Compartments in Which They Function 768  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "The Golgi Apparatus Consists of an Ordered Series of Compartments 769  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Oligosaccharide Chains Are Processed in the Golgi Apparatus 771  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Proteoglycans Are Assembled in the Golgi Apparatus 772  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "What Is the Purpose of Glycosylation? 773  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Transport Through the Golgi Apparatus Occurs by Multiple Mechanisms 774  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Golgi Matrix Proteins Help Organize the Stack 775  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Summary 776  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "TRANSPORT FROM THE TRANS GOLGI NETWORK TO THE CELL EXTERIOR AND ENDOSOMES 776  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Many Proteins and Lipids Are Carried Automatically from the Trans Golgi Network to the Cell Surface 777  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "A Mannose 6-Phosphate Receptor Sorts Lysosomal Hydrolases in the Trans Golgi Network 777  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Defects in the GlcNAc Phosphotransferase Cause a Lysosomal Storage Disease in Humans 779  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Secretory Vesicles Bud from the Trans Golgi Network 780  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Precursors of Secretory Proteins Are Proteolytically Processed During the Formation of Secretory Vesicles 781  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Secretory Vesicles Wait Near the Plasma Membrane Until Signaled to Release Their Contents 782  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "For Rapid Exocytosis, Synaptic Vesicles Are Primed at the Presynaptic Plasma Membrane 782  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Synaptic Vesicles Can Be Recycled Locally After Exocytosis 783  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Secretory Vesicle Membrane Components Are Quickly Removed from the Plasma Membrane 784  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Some Regulated Exocytosis Events Serve to Enlarge the Plasma Membrane 785  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Polarized Cells Direct Proteins from the Trans Golgi Network to the Appropriate Domain of the Plasma Membrane 786  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Summary 787  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "TRANSPORT INTO THE CELL FROM THE PLASMA MEMBRANE: ENDOCYTOSIS 788  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Pinocytic Vesicles Form from Coated Pits in the Plasma Membrane 789  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Not All Membrane Invaginations and Pinocytic Vesicles Are Clathrin Coated 789  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Cells Use Receptor-mediated Endocytosis to Import Selected Extracellular Macromolecules 791  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Specific Proteins Are Retrieved from Early Endosomes and Returned to the Plasma Membrane 792  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Recycling Endosomes Regulate Plasma Membrane Composition 793  "
                }
              ]
            },
            {
              "type": "text",
              "content": [
                {
                  "type": "text",
                  "content": "Plasma Membrane Signaling Receptors Are Down-regulated by Degradation in Lysosomes 794"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
