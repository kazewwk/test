              "bbox": [
                0.058,
                0.577,
                0.203,
                0.59
              ],
              "content": [
                {
                  "type": "text",
                  "content": "I can play the piano. My brother can play the piano too."
                }
              ]
            },
            {
              "type": "text",
              "index": 11,
              "bbox": [
                0.058,
                0.59,
                0.192,
                0.603
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Sarah can speak Italian, but she can't speak Spanish."
                }
              ]
            },
            {
              "type": "text",
              "index": 12,
              "bbox": [
                0.058,
                0.603,
                0.113,
                0.616
              ],
              "content": [
                {
                  "type": "text",
                  "content": "A: Can you swim?"
                }
              ]
            },
            {
              "type": "text",
              "index": 13,
              "bbox": [
                0.068,
                0.616,
                0.164,
                0.629
              ],
              "content": [
                {
                  "type": "text",
                  "content": "a: Yes, but I'm not a very good swimmer."
                }
              ]
            },
            {
              "type": "text",
              "index": 14,
              "bbox": [
                0.058,
                0.629,
                0.154,
                0.643
              ],
              "content": [
                {
                  "type": "text",
                  "content": "A. Can you change twenty pounds?"
