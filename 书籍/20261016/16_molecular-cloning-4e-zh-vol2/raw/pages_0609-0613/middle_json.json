          "content": [
            {
              "type": "ref_text",
              "index": 4,
              "bbox": [
                0.178,
                0.183,
                0.511,
                0.211
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Boudreau RL, Martins I, Davidson BL. 2009. Artificial microRNAs as siRNA shuttles: Improved safety as compared to shRNAs in vitro and in vivo. Mol Ther 17: 169–175."
                }
              ]
