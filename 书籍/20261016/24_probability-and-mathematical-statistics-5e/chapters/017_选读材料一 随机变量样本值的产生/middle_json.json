              ],
              "image_path": "raw/pages_0401-0416/images/page_402_table_5.jpg",
              "content": "<table><tr><td>X=i</td><td>1</td><td>2</td><td>3</td><td>4</td></tr><tr><td>pi</td><td>0.20</td><td>0.15</td><td>0.25</td><td>0.40</td></tr></table>"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.119,
            0.217,
            0.285,
            0.233
          ],
          "content": [
            {
              "type": "text",
              "content": "试产生 X 的样本值."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.156,
            0.239,
            0.417,
            0.256
          ],
          "content": [
            {
              "type": "text",
              "content": "解 取算法为:产生伪随机数 u."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.156,
            0.261,
            0.378,
            0.277
          ],
          "content": [
            {
              "type": "text",
              "content": "若 u<0.20, 令 X=1, 停止."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.156,
            0.283,
            0.378,
            0.299
          ],
          "content": [
            {
              "type": "text",
              "content": "若 u<0.35, 令 X=2, 停止."
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.156,
            0.305,
            0.378,
            0.321
          ],
          "content": [
            {
              "type": "text",
              "content": "若 u<0.60, 令 X=3, 停止."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.156,
            0.327,
            0.28,
            0.343
          ],
          "content": [
            {
              "type": "text",
              "content": "否则,令 X=4."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.156,
            0.349,
            0.427,
            0.366
          ],
          "content": [
            {
              "type": "text",
              "content": "例2 设随机变量 "
            },
            {
              "type": "equation_inline",
              "content": "X"
            },
            {
              "type": "text",
              "content": " 具有分布律"
            }
          ]
        },
        {
          "type": "equation",
          "index": 13,
          "bbox": [
            0.365,
            0.37,
            0.866,
            0.4
          ],
          "image_path": "raw/pages_0401-0416/images/page_402_equation_13.jpg",
          "content": "P \\{X = i \\} = \\frac {1}{n}, \\quad i = 1, 2, \\dots , n, \\tag {*_{3}}"
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.118,
            0.41,
            0.728,
            0.427
          ],
          "content": [
            {
              "type": "text",
              "content": "试产生 X 的样本值(X 称为取值为  "
            },
            {
              "type": "equation_inline",
              "content": "1,2,\\cdots,n"
            },
            {
              "type": "text",
              "content": "  的离散型均匀分布随机变量)."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.118,
            0.436,
            0.867,
            0.486
          ],
          "content": [
            {
              "type": "text",
              "content": "解 在 "
            },
            {
              "type": "equation_inline",
              "content": "(\\ast_{1})"
            },
            {
              "type": "text",
              "content": " 式中，令 "
            },
            {
              "type": "equation_inline",
              "content": "x_{i}=i,i=1,2,\\cdots,n;p_{1}=p_{2}=\\cdots=p_{n}=\\frac{1}{n}"
            },
            {
              "type": "text",
              "content": " ，就得到 "
            },
            {
              "type": "equation_inline",
              "content": "(\\ast_{3})"
            },
            {
              "type": "text",
              "content": " 式。再由 "
            },
            {
              "type": "equation_inline",
              "content": "(\\ast_{2})"
            },
            {
              "type": "text",
              "content": " 式，得"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.156,
            0.492,
            0.824,
            0.522
          ],
          "content": [
            {
              "type": "text",
              "content": "若 "
            },
            {
              "type": "equation_inline",
              "content": "\\frac{i-1}{n}\\leqslant u<\\frac{i}{n}"
            },
            {
              "type": "text",
              "content": " ，则令X=i，即若 "
            },
            {
              "type": "equation_inline",
              "content": "i-1\\leqslant nu<i"
            },
            {
              "type": "text",
              "content": " ，则令 "
            },
            {
              "type": "equation_inline",
              "content": "X=i=[nu]+1,i=1,2,\\cdots,n."
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.118,
            0.528,
            0.641,
            0.546
          ],
          "content": [
            {
              "type": "text",
              "content": "因此，若 "
            },
            {
              "type": "equation_inline",
              "content": "u"
            },
            {
              "type": "text",
              "content": " 是伪随机数，则 "
            },
            {
              "type": "equation_inline",
              "content": "X = [nu] + 1"
            },
            {
              "type": "text",
              "content": " 就是分布 "
            },
            {
              "type": "equation_inline",
              "content": "(\\ast_{3})"
            },
            {
              "type": "text",
              "content": " 的样本值."
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.155,
            0.551,
            0.621,
            0.568
          ],
          "content": [
            {
              "type": "text",
              "content": "例 3 试产生以 n, p 为参数的二项分布  "
            },
            {
              "type": "equation_inline",
              "content": "b(n, p)"
            },
            {
              "type": "text",
              "content": "  的样本值."
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.155,
            0.573,
            0.761,
            0.59
          ],
          "content": [
            {
              "type": "text",
              "content": "解 设  "
            },
            {
              "type": "equation_inline",
              "content": "U_{1}, U_{2}, \\cdots, U_{n}"
            },
            {
              "type": "text",
              "content": "  相互独立，且它们都在区间  "
            },
            {
              "type": "equation_inline",
              "content": "(0,1)"
            },
            {
              "type": "text",
              "content": "  上服从均匀分布. 令"
            }
          ]
        },
        {
          "type": "equation",
          "index": 20,
          "bbox": [
            0.351,
            0.595,
            0.634,
            0.629
          ],
          "image_path": "raw/pages_0401-0416/images/page_402_equation_20.jpg",
          "content": "X _ {i} = \\left\\{ \\begin{array}{l l} 1, & U _ {i} <   p, \\\\ 0, & U _ {i} \\geqslant p, \\end{array} \\right. i = 1, 2, \\dots , n,"
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.117,
            0.632,
            0.868,
            0.711
          ],
          "content": [
            {
              "type": "text",
              "content": "则有  "
            },
            {
              "type": "equation_inline",
              "content": "P\\{X_{i}=1\\}=P\\{U_{i}<p\\}=p, P\\{X_{i}=0\\}=1-p"
            },
            {
              "type": "text",
              "content": " ，故  "
            },
            {
              "type": "equation_inline",
              "content": "X_{i}\\sim b(1,p)"
            },
            {
              "type": "text",
              "content": " 。又因  "
            },
            {
              "type": "equation_inline",
              "content": "U_{1}, U_{2}, \\cdots, U_{n}"
            },
            {
              "type": "text",
              "content": "  相互独立，故有  "
            },
            {
              "type": "equation_inline",
              "content": "X=\\sum_{i=1}^{n}X_{i}\\sim b(n,p)"
            },
            {
              "type": "text",
              "content": " 。据此，只要产生 n 个伪随机数  "
            },
            {
              "type": "equation_inline",
              "content": "u_{1}, u_{2}, \\cdots, u_{n}"
            },
            {
              "type": "text",
              "content": " ，统计其中使得  "
            },
            {
              "type": "equation_inline",
              "content": "u_{i}<p"
            },
            {
              "type": "text",
              "content": "  ( "
            },
            {
              "type": "equation_inline",
              "content": "i=1,2,\\cdots,n"
            },
            {
              "type": "text",
              "content": " ) 的个数为 k，则得 X 的样本值为 k。"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 22,
          "bbox": [
            0.156,
            0.716,
            0.487,
            0.733
          ],
          "content": [
            {
              "type": "text",
              "content": "（三）产生连续型随机变量样本值的方法"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.156,
            0.738,
            0.298,
            0.754
          ],
          "content": [
            {
              "type": "text",
              "content": "先证明一个定理."
            }
          ]
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.118,
            0.76,
            0.868,
            0.798
          ],
          "content": [
            {
              "type": "text",
              "content": "定理 设随机变量  "
            },
            {
              "type": "equation_inline",
              "content": "U \\sim U(0,1)"
            },
            {
              "type": "text",
              "content": " ,  "
            },
            {
              "type": "equation_inline",
              "content": "F(x)"
            },
            {
              "type": "text",
              "content": "  是某一随机变量的分布函数, 且  "
            },
            {
              "type": "equation_inline",
              "content": "F(x)"
            },
            {
              "type": "text",
              "content": "  为严格单调增加且连续的函数, 则随机变量  "
            },
            {
              "type": "equation_inline",
              "content": "F^{-1}(U)"
            },
            {
              "type": "text",
              "content": "  具有分布函数  "
            },
            {
              "type": "equation_inline",
              "content": "F(x)"
            },
            {
              "type": "text",
              "content": " , 其中  "
            },
            {
              "type": "equation_inline",
              "content": "F^{-1}(x)"
            },
            {
              "type": "text",
              "content": "  是  "
            },
            {
              "type": "equation_inline",
              "content": "F(x)"
            },
            {
              "type": "text",
              "content": "  的反函数."
            }
          ]
        },
        {
          "type": "text",
          "index": 25,
          "bbox": [
            0.117,
            0.804,
            0.867,
            0.843
          ],
          "content": [
            {
              "type": "text",
              "content": "证 由于 "
            },
            {
              "type": "equation_inline",
              "content": "F(x)"
            },
            {
              "type": "text",
              "content": " 严格单调增加且连续，因此其反函数 "
            },
            {
              "type": "equation_inline",
              "content": "F^{-1}(x)"
            },
            {
              "type": "text",
              "content": " 存在（即有 "
            },
            {
              "type": "equation_inline",
              "content": "F[F^{-1}(x)] = x"
            },
            {
              "type": "text",
              "content": "），且严格单调增加并连续，即得随机变量 "
            },
            {
              "type": "equation_inline",
              "content": "F^{-1}(U)"
            },
            {
              "type": "text",
              "content": " 的分布函数为"
            }
          ]
        },
        {
          "type": "equation",
          "index": 26,
          "bbox": [
            0.321,
            0.847,
            0.66,
            0.887
          ],
          "image_path": "raw/pages_0401-0416/images/page_402_equation_26.jpg",
          "content": "\\begin{array}{l} P \\{F ^ {- 1} (U) \\leqslant x \\} = P \\{F [ F ^ {- 1} (U) ] \\leqslant F (x) \\} \\\\ = P \\{U \\leqslant F (x) \\} = F (x). \\\\ \\end{array}"
        },
        {
          "type": "text",
          "index": 27,
          "bbox": [
            0.155,
            0.893,
            0.866,
            0.91
          ],
          "content": [
            {
              "type": "text",
              "content": "由定理,若要产生以  "
            },
            {
              "type": "equation_inline",
              "content": "F(x)(F(x)"
            },
            {
              "type": "text",
              "content": "  严格单调增加且连续)为分布函数的随机变量 X, 只需"
            }
          ]
        }
      ]
    },
    {
      "page_idx": 403,
      "blocks": [
        {
          "type": "header",
          "index": 0,
          "bbox": [
            0.357,
            0.048,
            0.663,
            0.064
          ],
          "content": [
            {
              "type": "text",
              "content": "参读材料一 随机变量样本值的产生"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 1,
          "bbox": [
            0.802,
            0.049,
            0.867,
            0.063
          ],
          "content": [
            {
              "type": "text",
              "content": "· 389 ·"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.135,
            0.087,
            0.884,
            0.149
          ],
          "content": [
            {
              "type": "text",
              "content": "产生 "
            },
            {
              "type": "equation_inline",
              "content": "U \\sim U(0,1)"
            },
            {
              "type": "text",
              "content": "，令 "
            },
            {
              "type": "equation_inline",
              "content": "X = F^{-1}(U)"
            },
            {
              "type": "text",
              "content": " 就行了。又若要产生 "
            },
            {
              "type": "equation_inline",
              "content": "X"
            },
            {
              "type": "text",
              "content": " 的样本值 "
            },
            {
              "type": "equation_inline",
              "content": "x"
            },
            {
              "type": "text",
              "content": "，只需产生 "
            },
            {
              "type": "equation_inline",
              "content": "U"
            },
            {
              "type": "text",
              "content": " 的样本值 "
            },
            {
              "type": "equation_inline",
              "content": "u"
            },
            {
              "type": "text",
              "content": "，令 "
            },
            {
              "type": "equation_inline",
              "content": "x = F^{-1}(u)"
            },
            {
              "type": "text",
              "content": " 即得。这一产生 "
            },
            {
              "type": "equation_inline",
              "content": "X"
            },
            {
              "type": "text",
              "content": " 的样本值的方法，称为逆变换法。这种方法在随机变量具有严格单调增加且连续的分布函数 "
            },
            {
              "type": "equation_inline",
              "content": "F(x)"
            },
            {
              "type": "text",
              "content": " 且 "
            },
            {
              "type": "equation_inline",
              "content": "F^{-1}(x)"
            },
            {
              "type": "text",
              "content": " 能够用显式表示时，都能使用。"
            }
          ],
          "continues_prev": true
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.135,
            0.153,
            0.884,
            0.193
          ],
          "content": [
            {
              "type": "text",
              "content": "说明: 在上述定理中对  "
            },
            {
              "type": "equation_inline",
              "content": "F(x)"
            },
            {
              "type": "text",
              "content": "  在  "
            },
            {
              "type": "equation_inline",
              "content": "(-\\infty, \\infty)"
            },
            {
              "type": "text",
              "content": "  上的严格单调连续的要求可放宽为  "
            },
            {
              "type": "equation_inline",
              "content": "F(x)"
            },
            {
              "type": "text",
              "content": "  在某一区间(有限或无限)上取值从 0 到 1，并在此区间上严格单调增加且连续即可."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.171,
            0.197,
            0.584,
            0.213
          ],
          "content": [
            {
              "type": "text",
              "content": "例 4 设随机变量 X 具有指数分布, 其分布函数为"
            }
          ]
        },
        {
          "type": "equation",
          "index": 5,
          "bbox": [
            0.367,
            0.215,
            0.652,
            0.248
          ],
          "image_path": "raw/pages_0401-0416/images/page_403_equation_5.jpg",
          "content": "F (x) = \\left\\{ \\begin{array}{l l} 1 - \\mathrm{e} ^ {- x / \\theta}, & x > 0, \\\\ 0, & \\text {其他}, \\end{array} \\right. \\quad \\theta > 0,"
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.135,
            0.247,
            0.297,
            0.264
          ],
          "content": [
            {
              "type": "text",
              "content": "试产生随机变量 X."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.171,
            0.269,
            0.512,
            0.286
          ],
          "content": [
            {
              "type": "text",
              "content": "解 设  "
            },
            {
              "type": "equation_inline",
              "content": "U \\sim U(0,1)"
            },
            {
              "type": "text",
              "content": " ，令  "
            },
            {
              "type": "equation_inline",
              "content": "U = 1 - e^{-X/\\theta}"
            },
            {
              "type": "text",
              "content": " ，解得"
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.435,
            0.291,
            0.579,
            0.307
          ],
          "image_path": "raw/pages_0401-0416/images/page_403_equation_8.jpg",
          "content": "X = - \\theta \\ln (1 - U)."
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.172,
            0.313,
            0.57,
            0.33
          ],
          "content": [
            {
              "type": "text",
              "content": "因为当 "
            },
            {
              "type": "equation_inline",
              "content": "U \\sim U(0,1)"
            },
            {
              "type": "text",
              "content": " 时，也有 "
            },
            {
              "type": "equation_inline",
              "content": "1 - U \\sim U(0,1)"
            },
            {
              "type": "text",
              "content": "，从而"
            }
          ]
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.46,
            0.335,
            0.56,
            0.351
          ],
          "image_path": "raw/pages_0401-0416/images/page_403_equation_10.jpg",
          "content": "X = - \\theta \\ln U"
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.135,
            0.357,
            0.806,
            0.374
          ],
          "content": [
            {
              "type": "text",
              "content": "就是所要产生的指数分布的随机变量. 只要有伪随机数 "
            },
            {
              "type": "equation_inline",
              "content": "u"
            },
            {
              "type": "text",
              "content": ", 就有 "
            },
            {
              "type": "equation_inline",
              "content": "X"
            },
            {
              "type": "text",
              "content": " 的随机数 "
            },
            {
              "type": "equation_inline",
              "content": "-\\theta \\ln u"
            },
            {
              "type": "text",
              "content": "."
            }
          ]
        },
        {
          "type": "image",
          "index": 12,
          "bbox": [
            0.862,
            0.358,
            0.882,
            0.373
          ],
          "content": [
            {
              "type": "image_body",
              "index": 12,
              "bbox": [
                0.862,
                0.358,
                0.882,
                0.373
              ],
              "image_path": "raw/pages_0401-0416/images/page_403_image_12.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.171,
            0.379,
            0.602,
            0.396
          ],
          "content": [
            {
              "type": "text",
              "content": "例 5 设随机变量 X 具有韦布尔分布, 其分布函数为"
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.334,
            0.399,
            0.68,
            0.441
          ],
          "image_path": "raw/pages_0401-0416/images/page_403_equation_14.jpg",
          "content": "F (x) = \\left\\{ \\begin{array}{l l} 1 - \\mathrm{e} ^ {- (x / \\eta) ^ {\\beta}}, & x > 0, \\\\ 0, & \\text {其他}, \\end{array} \\right. \\quad \\beta > 0, \\eta > 0."
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.135,
            0.445,
            0.297,
            0.461
          ],
          "content": [
            {
              "type": "text",
              "content": "试产生随机变量 X."
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.171,
            0.465,
            0.531,
            0.484
          ],
          "content": [
            {
              "type": "text",
              "content": "解 设 "
            },
            {
              "type": "equation_inline",
              "content": "U \\sim U(0,1)"
            },
            {
              "type": "text",
              "content": ", 令 "
            },
            {
              "type": "equation_inline",
              "content": "U = 1 - \\mathrm{e}^{-(X / \\eta)^{\\beta}}"
            },
            {
              "type": "text",
              "content": ", 解得"
            }
          ]
        },
        {
          "type": "equation",
          "index": 17,
          "bbox": [
            0.416,
            0.488,
            0.598,
            0.508
          ],
          "image_path": "raw/pages_0401-0416/images/page_403_equation_17.jpg",
          "content": "X = \\eta [ - \\ln (1 - U) ] ^ {1 / \\beta}."
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.135,
            0.51,
            0.331,
            0.527
          ],
          "content": [
            {
              "type": "text",
              "content": "因为 "
            },
            {
              "type": "equation_inline",
              "content": "1 - U\\sim U(0,1)"
            },
            {
              "type": "text",
              "content": " ，故"
            }
          ]
        },
        {
          "type": "equation",
          "index": 19,
          "bbox": [
            0.44,
            0.532,
            0.578,
            0.551
          ],
          "image_path": "raw/pages_0401-0416/images/page_403_equation_19.jpg",
          "content": "X = \\eta (- \\ln U) ^ {1 / \\beta}"
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.135,
            0.555,
            0.466,
            0.572
          ],
          "content": [
            {
              "type": "text",
              "content": "就是所要产生的韦布尔分布的随机变量."
            }
          ]
        },
        {
          "type": "image",
          "index": 21,
          "bbox": [
            0.862,
            0.556,
            0.882,
            0.571
          ],
          "content": [
            {
              "type": "image_body",
              "index": 21,
              "bbox": [
                0.862,
                0.556,
                0.882,
                0.571
              ],
              "image_path": "raw/pages_0401-0416/images/page_403_image_21.jpg",
              "content": ""
            }
          ]
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.171,
            0.577,
            0.404,
            0.594
          ],
          "content": [
            {
              "type": "text",
              "content": "例 6 正态随机变量的产生."
            }
          ]
        },
        {
          "type": "text",
          "index": 23,
          "bbox": [
            0.135,
            0.599,
            0.884,
            0.637
          ],
          "content": [
            {
              "type": "text",
              "content": "标准正态变量的分布函数 "
            },
            {
              "type": "equation_inline",
              "content": "\\Phi (x)"
            },
            {
              "type": "text",
              "content": " 的反函数不存在显式，故不能用逆变换法产生标准正态变量.下面介绍一种近似方法."
            }
          ]
        },
        {
          "type": "text",
          "index": 24,
          "bbox": [
            0.134,
            0.643,
            0.884,
            0.681
          ],
          "content": [
            {
              "type": "text",
              "content": "设  "
            },
            {
              "type": "equation_inline",
              "content": "U_{i} \\sim U(0,1), i=1,2,\\cdots,n"
            },
            {
              "type": "text",
              "content": " ，且它们相互独立，由于  "
            },
            {
              "type": "equation_inline",
              "content": "E(U_{i})=1/2, D(U_{i})=1/12"
            },
            {
              "type": "text",
              "content": " ，由中心极限定理，当 n 较大时近似地有"
            }
          ]
        },
        {
          "type": "equation",
          "index": 25,
          "bbox": [
            0.385,
            0.684,
            0.622,
            0.753
          ],
          "image_path": "raw/pages_0401-0416/images/page_403_equation_25.jpg",
          "content": "Z = \\frac {\\sum_ {i = 1} ^ {n} U _ {i} - \\frac {n}{2}}{\\sqrt {n} \\sqrt {\\frac {1}{1 2}}} \\sim N (0, 1)."
        },
        {
          "type": "text",
          "index": 26,
          "bbox": [
            0.135,
            0.754,
            0.312,
            0.77
          ],
          "content": [
            {
              "type": "text",
              "content": "取 n=12, 知近似地有"
            }
          ]
        },
        {
          "type": "equation",
          "index": 27,
          "bbox": [
            0.393,
            0.77,
            0.618,
            0.807
          ],
          "image_path": "raw/pages_0401-0416/images/page_403_equation_27.jpg",
          "content": "Z = \\sum_ {i = 1} ^ {1 2} U _ {i} - 6 \\sim N (0, 1),"
        },
        {
          "type": "text",
          "index": 28,
          "bbox": [
            0.134,
            0.806,
            0.884,
            0.845
          ],
          "content": [
            {
              "type": "text",
              "content": "这就是说，只需产生12个伪随机数 "
            },
            {
              "type": "equation_inline",
              "content": "u_{1}, u_{2}, \\cdots, u_{12}"
            },
            {
              "type": "text",
              "content": "，将它们加起来，再减去6，就能近似地得到标准正态变量的样本值了。这样做是很方便的。"
            }
          ]
        },
        {
          "type": "text",
          "index": 29,
          "bbox": [
            0.172,
            0.849,
            0.53,
            0.867
          ],
          "content": [
            {
              "type": "text",
              "content": "又若 "
            },
            {
              "type": "equation_inline",
              "content": "X \\sim N(\\mu, \\sigma^2), Z \\sim N(0,1)"
            },
            {
              "type": "text",
              "content": "，利用关系式"
            }
          ]
        },
        {
          "type": "equation",
          "index": 30,
          "bbox": [
            0.466,
            0.871,
            0.554,
            0.889
          ],
          "image_path": "raw/pages_0401-0416/images/page_403_equation_30.jpg",
          "content": "X = \\mu + \\sigma Z"
        },
        {
          "type": "text",
          "index": 31,
          "bbox": [
            0.135,
            0.894,
            0.489,
            0.911
          ],
          "content": [
            {
