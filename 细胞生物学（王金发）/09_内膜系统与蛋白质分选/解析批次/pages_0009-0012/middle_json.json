            {
              "type": "text",
              "content": "271"
            }
          ]
        },
        {
          "type": "image",
          "index": 2,
          "bbox": [
            0.059,
            0.091,
            0.483,
            0.303
          ],
          "content": [
            {
              "type": "image_body",
              "index": 2,
