          "content": [
            {
              "type": "text",
              "content": "9 内膜系统与蛋白质分选"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 1,
          "bbox": [
            0.909,
            0.055,
            0.939,
            0.071
          ],
