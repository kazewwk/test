            0.277,
            0.448,
            0.293
          ],
          "content": [
            {
              "type": "text",
              "content": "4. IP3 打开( )的钙通道。"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.187,
            0.296,
            0.748,
            0.312
          ],
          "content": [
            {
              "type": "text",
              "content": "a. 细胞膜 b. 线粒体膜 c. 肌浆网膜 d. 核膜"
            }
          ]
        },
        {
