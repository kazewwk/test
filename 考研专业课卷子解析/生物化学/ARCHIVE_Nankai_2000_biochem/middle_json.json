            0.614,
            0.331
          ],
          "content": [
            {
              "type": "text",
              "content": "5. 甘油二酯作为信号分子的主要作用是激活:"
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
