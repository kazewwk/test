            0.382,
            0.182
          ],
          "content": [
            {
              "type": "text",
              "content": "1. 维生素 D1 原是:"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.187,
            0.185,
            0.837,
            0.201
          ],
          "content": [
            {
              "type": "text",
              "content": "a. 胆固醇 b. 谷固醇 c. 麦角固醇 d. 7-脱氢胆固醇"
            }
          ]
        },
        {
          "type": "text",
