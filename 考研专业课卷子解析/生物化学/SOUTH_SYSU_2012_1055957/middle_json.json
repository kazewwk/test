              ],
              "image_path": "images/page_2_image_2.jpg",
              "content": "```mermaid\ngraph LR\n  A[\"Apical surface\"] --> B[\"Blood\"]\n  C[\"Basal surface\"] --> B\n  D[\"Microvilli\"] --> E[\"Epithelial cell\"]\n  F[\"Glucose\"] --> G[\"Glucose uniporter GLUT2\"]\n  H[\"Na+ glucose symporter\"] --> I[\"Glucose\"]\n  J[\"2 Na+\"] --> I\n  K[\"3 Na+\"] --> L[\"ATPase\"]\n  M[\"2 K+\"] --> L\n  N[\"Na+K+\"] --> L\n  O[\"Glucose\"] --> L\n  P[\"Glucose\"] --> L\n  Q[\"Glucose uniporter GLUT2\"] --> L\n  R[\"Epithelial cell\"] -.-> E\n  S[\"Glucose\"] -.-> E\n```"
            }
          ],
          "sub_type": "flowchart"
        },
        {
          "type": "list",
          "index": 9,
          "bbox": [
            0.089,
