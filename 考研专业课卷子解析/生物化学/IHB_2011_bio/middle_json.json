          "bbox": [
            0.182,
            0.865,
            0.606,
            0.881
          ],
          "content": [
            {
              "type": "text",
              "content": "a.糖原磷酸化酶 b.葡萄糖变位酶 c.糖原合酶 d.分支酶"
