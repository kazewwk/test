            {
              "type": "text",
              "index": 26,
              "bbox": [
                0.071,
                0.566,
                0.394,
                0.583
              ],
              "content": [
                {
                  "type": "text",
                  "content": "8、简述七跨膜受体的结构和功能特点。"
