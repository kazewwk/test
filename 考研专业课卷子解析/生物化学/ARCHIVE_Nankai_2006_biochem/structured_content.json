            0.591
          ],
          "content": "D. 1/6[S]"
        },
        {
          "type": "text",
          "bbox": [
            0.148,
            0.593,
            0.33,
            0.608
          ],
          "content": "10. 泛酸的辅酶形式是"
        },
        {
