          "level": 2
        },
        {
          "type": "paragraph_title",
          "index": 5,
          "bbox": [
            0.147,
            0.185,
            0.739,
            0.201
          ],
          "content": [
            {
              "type": "text",
              "content": "一.判断下列说法正确与否（对“√”，错者划“×”，每小题1分，共15分）"
            }
          ],
          "level": 2
        },
        {
          "type": "list",
          "index": 6,
          "bbox": [
            0.147,
