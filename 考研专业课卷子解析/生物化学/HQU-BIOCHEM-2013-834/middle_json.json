            0.231
          ],
          "content": [
            {
              "type": "text",
              "content": "一、名词解释（每个3分，共30分）"
            }
          ],
          "level": 2
        },
        {
          "type": "list",
          "index": 5,
          "bbox": [
            0.058,
            0.234,
            0.951,
            0.274
          ],
          "content": [
            {
              "type": "text",
