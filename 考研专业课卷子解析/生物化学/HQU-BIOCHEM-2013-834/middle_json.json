            {
              "type": "text",
              "index": 13,
              "bbox": [
                0.072,
                0.421,
                0.381,
                0.439
              ],
              "content": [
                {
                  "type": "text",
                  "content": "(2) 何处可能形成链内二硫键?"
                }
              ]
