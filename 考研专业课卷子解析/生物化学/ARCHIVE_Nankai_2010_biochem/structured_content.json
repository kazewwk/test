        {
          "type": "text",
          "bbox": [
            0.036,
            0.112,
            0.901,
            0.158
          ],
          "content": "专业:★生物信息学、植物学、动物学、生理学、微生物学、遗传学、细胞生物学、生物化学与分子生物学、生物物理学、生态学"
        },
