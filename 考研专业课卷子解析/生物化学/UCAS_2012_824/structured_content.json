          "type": "text",
          "bbox": [
            0.175,
            0.41,
            0.252,
            0.427
          ],
          "content": "A、1个"
        },
        {
          "type": "text",
          "bbox": [
            0.347,
            0.41,
            0.42,
            0.427
          ],
          "content": "B、2 个"
        },
        {
          "type": "text",
          "bbox": [
            0.517,
            0.41,
            0.59,
            0.427
          ],
          "content": "C、3个"
        },
        {
          "type": "text",
          "bbox": [
            0.687,
            0.41,
            0.761,
            0.427
          ],
          "content": "D、4个"
        },
        {
          "type": "text",
          "bbox": [
            0.137,
            0.438,
            0.477,
            0.455
          ],
          "content": "2、下列有关糖苷性质的叙述正确的是"
