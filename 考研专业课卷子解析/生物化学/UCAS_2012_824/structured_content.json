        {
          "type": "paragraph_title",
          "bbox": [
            0.139,
            0.308,
            0.467,
            0.325
          ],
          "level": 2,
          "content": "一、选择题（共40分，每小题1分）"
        },
        {
          "type": "text",
          "bbox": [
            0.138,
            0.335,
            0.859,
            0.372
          ],
          "content": "（第 1\\~30 小题，请从 4 个选项中选出 1 个正确答案；第 31\\~40 小题，请从 4 个选项中选出 2 个正确答案）"
        },
        {
          "type": "text",
          "bbox": [
            0.139,
            0.382,
            0.559,
            0.399
          ],
          "content": "1、单糖游离羰基能与几分子苯肼作用生成糖脎"
