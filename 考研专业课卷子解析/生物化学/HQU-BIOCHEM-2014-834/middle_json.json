            },
            {
              "type": "text",
              "index": 15,
              "bbox": [
                0.057,
                0.546,
                0.781,
                0.566
              ],
              "content": [
                {
                  "type": "text",
                  "content": "6、以下列 DNA 片断为模板， F1: 3' —ATACAGTCGAGCACTGATCAC—5'"
                }
              ]
            }
          ],
          "sub_type": "text"
        },
        {
