                  "content": "；末端-"
                },
                {
                  "type": "equation_inline",
                  "content": "\\mathrm{NH}_3"
                },
                {
                  "type": "text",
                  "content": " 的 "
                },
                {
                  "type": "equation_inline",
                  "content": "\\mathrm{pK} = 9.07"
                },
                {
                  "type": "text",
                  "content": "；"
                },
                {
                  "type": "equation_inline",
                  "content": "\\beta"
                },
                {
                  "type": "text",
                  "content": "-COOH 的 "
                },
                {
                  "type": "equation_inline",
                  "content": "\\mathrm{pK} = 4.53"
                },
                {
                  "type": "text",
                  "content": "）"
                }
              ]
            },
            {
              "type": "text",
              "index": 12,
              "bbox": [
                0.087,
                0.702,
                0.76,
                0.754
              ],
              "content": [
                {
                  "type": "text",
                  "content": "2) 谷胱甘肽（Glu末端-COOH的 "
                },
                {
                  "type": "equation_inline",
                  "content": "\\mathrm{pK} = 2.12"
                },
                {
                  "type": "text",
                  "content": "；"
                },
                {
