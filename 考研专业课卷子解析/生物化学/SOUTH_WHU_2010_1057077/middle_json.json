        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.09,
            0.268,
            0.451,
            0.286
          ],
          "content": [
            {
              "type": "text",
              "content": "a. NAD+; b. CoA; c. TPP; d. FMN"
