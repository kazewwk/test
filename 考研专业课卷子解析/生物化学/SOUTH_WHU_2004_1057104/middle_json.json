          ],
          "image_path": "images/page_1_equation_9.jpg",
          "content": "\\text {草酰乙酸} + 2 \\mathrm{H} ^ {+} + 2 \\mathrm{e} = \\text {苹果酸} \\quad \\mathrm{E} _ {\\mathrm{o}} ^ {\\prime} = - 0. 1 6 6 \\mathrm{V}"
