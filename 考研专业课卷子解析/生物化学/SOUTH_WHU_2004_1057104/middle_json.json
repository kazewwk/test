        },
        {
          "type": "text",
          "index": 36,
          "bbox": [
            0.202,
            0.757,
            0.613,
            0.776
          ],
          "content": [
            {
              "type": "text",
              "content": "C. DNA 和 RNA 合成的方向是相同的;"
            }
