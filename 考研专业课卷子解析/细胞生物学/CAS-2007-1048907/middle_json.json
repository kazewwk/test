              "bbox": [
                0.146,
                0.707,
                0.799,
                0.72
              ],
              "content": [
                {
                  "type": "text",
                  "content": "2. 说明流式细胞仪工作原理及其在测定和分选不同类型免疫细胞的应用。"
                }
              ]
            }
          ],
          "sub_type": "text"
