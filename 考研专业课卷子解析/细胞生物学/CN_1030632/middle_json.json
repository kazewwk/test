            0.119
          ],
          "content": [
            {
              "type": "text",
              "content": "2. 根据对真核细胞周期调控的了解，解释下面的实验观察结果:(共8分)"
            }
          ]
        },
        {
          "type": "list",
          "index": 7,
          "bbox": [
            0.15,
