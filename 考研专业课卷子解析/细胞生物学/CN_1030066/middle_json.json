            },
            {
              "type": "text",
              "index": 11,
              "bbox": [
                0.174,
                0.331,
                0.308,
                0.353
              ],
              "content": [
                {
                  "type": "text",
                  "content": "③皮肤细胞;"
                }
              ]
            },
            {
              "type": "text",
              "index": 12,
              "bbox": [
                0.534,
                0.335,
                0.834,
                0.359
              ],
              "content": [
                {
                  "type": "text",
                  "content": "④在分裂过程中的植物细胞."
