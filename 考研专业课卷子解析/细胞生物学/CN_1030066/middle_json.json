        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.136,
            0.496,
            0.925,
            0.522
          ],
          "content": [
            {
              "type": "text",
              "content": "11. Which of the following changes takes place when a skeletal muscle contracts?"
            }
          ]
        },
        {
          "type": "text",
          "index": 20,
          "bbox": [
            0.169,
            0.527,
            0.46,
            0.551
          ],
          "content": [
            {
              "type": "text",
              "content": "①Z discs move farther apart;"
            }
          ]
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.515,
            0.53,
            0.785,
            0.554
          ],
          "content": [
            {
              "type": "text",
              "content": "②Actin filaments contract;"
            }
          ]
        },
        {
          "type": "text",
          "index": 22,
          "bbox": [
            0.17,
            0.559,
            0.46,
            0.583
          ],
          "content": [
            {
              "type": "text",
              "content": "③Myosin filaments contract;"
