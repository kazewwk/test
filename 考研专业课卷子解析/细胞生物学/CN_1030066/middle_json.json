              ]
            },
            {
              "type": "text",
              "index": 18,
              "bbox": [
                0.544,
                0.466,
                0.77,
                0.489
              ],
              "content": [
                {
                  "type": "text",
                  "content": "④笼形蛋白基因缺损."
