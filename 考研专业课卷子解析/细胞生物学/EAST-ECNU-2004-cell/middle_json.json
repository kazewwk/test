            {
              "type": "text",
              "index": 24,
              "bbox": [
                0.079,
                0.606,
                0.363,
                0.624
              ],
              "content": [
                {
                  "type": "text",
                  "content": "4、简述细胞增殖时的调控机制。"
                }
