          "content": [
            {
              "type": "text",
              "index": 9,
              "bbox": [
                0.096,
                0.278,
                0.369,
                0.293
              ],
              "content": [
                {
                  "type": "text",
                  "content": "A. 肌动蛋白是微丝的基础蛋白质。"
                }
