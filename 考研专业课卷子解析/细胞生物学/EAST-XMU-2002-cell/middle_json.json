                0.353,
                0.322,
                0.367
              ],
              "content": [
                {
                  "type": "text",
                  "content": "7. 干细胞（stem cell）"
                }
              ]
            },
            {
              "type": "text",
              "index": 15,
              "bbox": [
                0.147,
                0.371,
                0.539,
                0.387
              ],
              "content": [
