          ]
        },
        {
          "type": "text",
          "index": 40,
          "bbox": [
            0.147,
            0.872,
            0.434,
            0.886
          ],
          "content": [
            {
              "type": "text",
              "content": "8.膜蛋白高度糖基化的是____。"
            }
          ]
        },
        {
          "type": "text",
          "index": 41,
          "bbox": [
            0.147,
            0.89,
            0.51,
            0.905
          ],
