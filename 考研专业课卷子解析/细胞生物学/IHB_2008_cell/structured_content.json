        {
          "type": "text",
          "bbox": [
            0.379,
            0.466,
            0.482,
            0.483
          ],
          "content": "D. 细胞碎片"
        },
        {
          "type": "text",
          "bbox": [
            0.17,
            0.508,
            0.439,
            0.526
          ],
          "content": "5、光面内质网的主要功能是:"
