        {
          "type": "text",
          "bbox": [
            0.171,
            0.358,
            0.275,
            0.376
          ],
          "content": "A.钙粘蛋白"
        },
        {
          "type": "text",
          "bbox": [
            0.361,
            0.359,
            0.462,
            0.376
          ],
          "content": "B.网格蛋白"
        },
        {
          "type": "text",
          "bbox": [
            0.171,
            0.38,
            0.255,
            0.397
          ],
          "content": "C. 调节素"
        },
        {
          "type": "text",
          "bbox": [
            0.349,
            0.38,
            0.452,
            0.397
