            ]
          }
        ]
      },
      {
        "type": "text",
        "bbox": [
          0.035,
          0.972,
          0.731,
          0.992
        ],
        "content": [
          {
            "type": "text",
            "content": "(2) 如何理解进入新时代必须 “以改革开放的眼光看待改革开放”？（5分）"
          }
        ],
        "lines": [
          {
            "bbox": [
              0.043,
              0.976,
