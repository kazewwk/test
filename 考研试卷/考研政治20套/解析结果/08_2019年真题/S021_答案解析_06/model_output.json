          0.978,
          0.994
        ],
        "content": [
          {
            "type": "text",
            "content": "“实践没有止境，理论创新也没有止境”说明实践作为检验真理的标准，既是确定性的，又是不确定性"
          }
        ],
        "lines": [
          {
            "bbox": [
              0.056,
              0.977,
              0.977,
              0.992
            ]
          }
        ]
