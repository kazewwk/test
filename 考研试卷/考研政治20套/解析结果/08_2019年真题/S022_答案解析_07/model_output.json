              0.409
            ]
          },
          {
            "bbox": [
              0.0,
              0.423,
              0.747,
              0.438
            ]
          }
        ]
      },
      {
        "type": "text",
        "bbox": [
          0.0,
          0.476,
          0.987,
          0.524
        ],
        "content": [
          {
            "type": "text",
            "content": "在马克思主义的指导下，中国革命出现了新局面。中国革命从此有了科学理论的指导、坚强的领导核心、正确的纲领和奋斗目标以及全新的革命方法。"
          }
        ],
        "lines": [
          {
            "bbox": [
