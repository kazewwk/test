            0.343,
            0.906
          ],
          "sub_type": "text",
          "content": "A.以开放包容为襟怀\nB.以合作共赢为目标"
        }
      ]
    },
    {
      "page_idx": 10,
      "blocks": [
        {
          "type": "list",
          "bbox": [
