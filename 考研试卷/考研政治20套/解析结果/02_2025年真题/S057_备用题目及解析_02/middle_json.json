            0.906
          ],
          "content": [
            {
              "type": "text",
              "content": "【解析】本题考查的知识点:半殖民半封建社会"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 17,
          "bbox": [
            0.871,
            0.925,
