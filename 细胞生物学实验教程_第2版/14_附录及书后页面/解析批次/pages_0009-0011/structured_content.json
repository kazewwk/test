            0.163,
            0.157,
            0.579,
            0.177
          ],
          "level": 2,
          "content": "（一）LB 培养基（Luria-Bertani 培养基）"
        },
        {
          "type": "text",
          "bbox": [
            0.163,
            0.19,
            0.539,
            0.208
          ],
          "content": "1L 培养基，应在 950ml 去离子水中加入:"
        },
        {
          "type": "text",
          "bbox": [
            0.181,
            0.212,
            0.679,
            0.23
          ],
          "content": "细菌培养用胰蛋白胨（bacto-tryptone） 10g"
        },
        {
          "type": "text",
          "bbox": [
            0.183,
            0.233,
            0.672,
            0.251
          ],
          "content": "细菌培养用酵母提取物（bacto-yeast extract） 5g"
        },
