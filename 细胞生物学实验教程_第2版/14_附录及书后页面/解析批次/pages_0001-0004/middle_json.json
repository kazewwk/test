          "content": [
            {
              "type": "text",
              "content": "离心机转速与离心力的换算"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.155,
            0.307,
            0.594,
            0.325
          ],
          "content": [
            {
              "type": "text",
              "content": "相对离心力（RCF）与离心机转速的换算公式为"
            }
          ]
        },
        {
          "type": "equation",
          "index": 4,
          "bbox": [
            0.337,
            0.332,
            0.678,
            0.351
          ],
          "image_path": "images/page_0_equation_4.jpg",
          "content": "\\mathrm{RCF} (g) = 1. 1 1 9 \\times 1 0 ^ {- 5} \\times r \\times \\mathrm{r} / \\min"
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.114,
            0.358,
            0.898,
            0.397
          ],
          "content": [
            {
              "type": "text",
              "content": "式中，RCF为相对离心力（单位为 "
            },
            {
              "type": "equation_inline",
              "content": "g"
            },
            {
              "type": "text",
              "content": " ）； "
            },
            {
              "type": "equation_inline",
              "content": "r"
            },
            {
              "type": "text",
              "content": " 为离心机转头的半径（单位为cm）； "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm{r / min}"
            },
            {
              "type": "text",
              "content": " 为离心机每分钟的转数。"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.157,
            0.401,
            0.33,
            0.418
          ],
          "content": [
            {
              "type": "text",
              "content": "核酸分光光度换算"
            }
          ]
        },
        {
          "type": "equation",
          "index": 7,
          "bbox": [
            0.178,
            0.421,
            0.454,
            0.441
          ],
          "image_path": "images/page_0_equation_7.jpg",
          "content": "1 \\mathrm{OD} _ {2 6 0} = 5 0 \\mu \\mathrm{g/ml} \\quad \\text {双链 DNA}"
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.177,
            0.443,
            0.455,
            0.462
          ],
          "image_path": "images/page_0_equation_8.jpg",
          "content": "1 \\mathrm{OD} _ {2 6 0} = 3 3 \\mu \\mathrm{g/ml} \\quad \\text {单链 DNA}"
        },
        {
          "type": "equation",
          "index": 9,
