            0.174,
            0.655,
            0.191
          ],
          "image_path": "images/page_18_equation_6.jpg",
          "content": "\\text {N - Bgl - 24: d (AGGCAACTGTGCTATCCGAGGGAA)}"
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.152,
            0.196,
            0.395,
            0.213
          ],
          "content": [
            {
              "type": "text",
              "content": "22）荧光检测的试剂包括:"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.111,
            0.218,
            0.891,
            0.256
          ],
          "content": [
            {
              "type": "text",
              "content": "TNE 缓冲液:100mmol/L Tris-HCl (pH7.4)，10mmol/L EDTA，2mol/L NaCl，赫希斯特染料 33258。"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.152,
            0.26,
            0.519,
            0.278
          ],
          "content": [
            {
              "type": "text",
              "content": "DNA 标准:小牛胸腺 DNA 来自 Sigma。"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 10,
          "bbox": [
            0.111,
            0.29,
            0.285,
            0.312
          ],
          "content": [
            {
              "type": "text",
              "content": "【方法与步骤】"
            }
          ],
          "level": 2
        },
        {
          "type": "paragraph_title",
          "index": 11,
          "bbox": [
            0.154,
            0.324,
            0.493,
            0.342
          ],
          "content": [
            {
              "type": "text",
              "content": "（一）RNA提取和cDNA的形成"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.111,
            0.356,
            0.898,
            0.439
          ],
          "content": [
            {
              "type": "text",
              "content": "RNA 的提取，使用酚/硫氰酸胍的方法比基于纯化柱的方法好。如果用 DNA 酶处理总 RNA 的话，可使用没有 RNA 酶的 DNA 酶，同时使用 RNA 酶抑制因子，以免引起 RNA 降解。分离 mRNA 使用磁珠法。mRNA 的含量可以采用吸光法测量，但要保证样品能够从比色皿中回收。"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.112,
            0.444,
            0.898,
            0.528
          ],
          "content": [
            {
              "type": "text",
              "content": "双链 cDNA 的合成使用 Superscript double-stranded cDNA synthesis 试剂盒。引物是在 5' 端有两个随机碱基锚定的 dT"
            },
            {
              "type": "equation_inline",
              "content": "_{(15)}"
            },
            {
              "type": "text",
              "content": " 或者 dT"
            },
            {
              "type": "equation_inline",
              "content": "_{(13)}"
            },
            {
              "type": "text",
              "content": "。通常用于量化和质量控制的放射性标记应该加入到一份样品中，而不是整个 cDNA 制备物。最后得到的双链 cDNA 与最初 mRNA 的量接近。"
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 14,
          "bbox": [
            0.155,
            0.541,
            0.596,
            0.56
          ],
          "content": [
            {
              "type": "text",
              "content": "（二）产生表达差异:准备驱动子和检测子"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.113,
            0.574,
            0.897,
            0.613
          ],
          "content": [
            {
              "type": "text",
              "content": "（1）使用  "
            },
            {
              "type": "equation_inline",
              "content": "1 \\sim 1.5 \\mu g"
            },
            {
              "type": "text",
              "content": "  质量好的 cDNA 进行酶切。如果样品少于  "
            },
            {
              "type": "equation_inline",
              "content": "1 \\mu g"
            },
            {
              "type": "text",
              "content": " ，则可能需要增加最终的循环反应数目。"
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.113,
            0.617,
            0.9,
            0.678
          ],
          "content": [
            {
              "type": "text",
              "content": "(2) 混合 "
            },
            {
              "type": "equation_inline",
              "content": "10\\mu \\mathrm{l} 10 \\times \\mathrm{Dpn}"
            },
            {
              "type": "text",
              "content": " Ⅱ缓冲液、"
            },
            {
              "type": "equation_inline",
              "content": "5\\mu \\mathrm{l}"
            },
            {
              "type": "text",
              "content": " Dpn Ⅱ、cDNA 以及水，总体积 "
            },
            {
              "type": "equation_inline",
              "content": "100\\mu \\mathrm{l}"
            },
            {
              "type": "text",
              "content": "，在 "
            },
            {
              "type": "equation_inline",
              "content": "37^{\\circ} \\mathrm{C}"
            },
            {
              "type": "text",
              "content": " 下静置至少 "
            },
            {
              "type": "equation_inline",
              "content": "2 \\mathrm{~h}"
            },
            {
              "type": "text",
              "content": " 后，"
            },
            {
              "type": "equation_inline",
              "content": "65^{\\circ} \\mathrm{C}"
            },
            {
              "type": "text",
              "content": " 下 "
            },
            {
              "type": "equation_inline",
              "content": "10 \\mathrm{~min}"
            },
            {
              "type": "text",
              "content": " 以使酶失活，加 "
            },
            {
              "type": "equation_inline",
              "content": "500\\mu \\mathrm{l}"
            },
            {
              "type": "text",
              "content": " Qiaquick 试剂盒中的 PB 缓冲液。"
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.113,
            0.682,
            0.899,
            0.787
          ],
          "content": [
            {
              "type": "text",
              "content": "(3) 在收集管中放置一个 Qiaquick 的离心柱（不加液体），将样品加到柱中，离心 60s 以便结合 cDNA。弃去收集管中液体，把柱放回管中。加试剂盒中的 PE 缓冲液 "
            },
            {
              "type": "equation_inline",
              "content": "750 \\mu \\mathrm{l}"
            },
            {
              "type": "text",
              "content": "，静置 "
            },
            {
              "type": "equation_inline",
              "content": "5 \\mathrm{~min}"
            },
            {
              "type": "text",
              "content": "，离心 "
            },
            {
              "type": "equation_inline",
              "content": "60 \\mathrm{~s}"
            },
            {
              "type": "text",
              "content": "。弃去收集管中液体，把柱放回收集管再离心 "
            },
            {
              "type": "equation_inline",
              "content": "1 \\mathrm{~min}"
            },
            {
              "type": "text",
              "content": "，以便除去剩余的缓冲液。将柱放置于新的试管中，以洗脱 cDNA。加 "
            },
            {
              "type": "equation_inline",
              "content": "42 \\mu \\mathrm{l} \\mathrm{EB}"
            },
            {
              "type": "text",
              "content": " 缓冲液到膜中央，静置 "
            },
            {
              "type": "equation_inline",
              "content": "1 \\mathrm{~min}"
            },
            {
              "type": "text",
              "content": "，离心 "
            },
            {
              "type": "equation_inline",
              "content": "1 \\mathrm{~min}"
            },
            {
              "type": "text",
              "content": "。立刻进行下面的步骤。"
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.113,
            0.791,
            0.9,
            0.874
          ],
          "content": [
            {
              "type": "text",
              "content": "（4）将  "
            },
            {
              "type": "equation_inline",
              "content": "8\\mu l"
            },
            {
              "type": "text",
              "content": "  R-Bam-24， "
            },
            {
              "type": "equation_inline",
              "content": "4\\mu l"
            },
            {
              "type": "text",
              "content": "  R-Bam-12， "
            },
            {
              "type": "equation_inline",
              "content": "6\\mu l"
            },
            {
              "type": "text",
              "content": "   "
            },
            {
              "type": "equation_inline",
              "content": "10\\times"
            },
            {
              "type": "text",
              "content": "  连接酶缓冲液， "
            },
            {
              "type": "equation_inline",
              "content": "39\\mu l"
            },
            {
              "type": "text",
              "content": "  Qiaquick 柱洗脱液加入收集管并混合。将样品放置于  "
            },
            {
              "type": "equation_inline",
              "content": "50^{\\circ}C"
            },
            {
              "type": "text",
              "content": "  的加热板上，将加热板在冷冻室内冷却至少 1h，直至板的温度低于  "
            },
            {
              "type": "equation_inline",
              "content": "14^{\\circ}C"
            },
            {
              "type": "text",
              "content": " 。将试管放置在冰上，加  "
            },
            {
              "type": "equation_inline",
              "content": "3\\mu l"
            },
            {
              "type": "text",
              "content": "  T4 DNA 连接酶，在  "
            },
            {
              "type": "equation_inline",
              "content": "14^{\\circ}C"
            },
            {
              "type": "text",
              "content": "  下静置过夜。随后，加  "
            },
            {
              "type": "equation_inline",
              "content": "140\\mu l"
            },
            {
              "type": "text",
              "content": "  TE 以稀释连接液。"
            }
          ]
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.156,
            0.877,
            0.899,
            0.895
          ],
          "content": [
            {
              "type": "text",
              "content": "(5) 准备一个 PCR 反应来检测酶切和连接是否成功。混合 "
            },
            {
              "type": "equation_inline",
              "content": "69\\mu \\mathrm{l}"
            },
            {
              "type": "text",
              "content": " 水、"
            },
            {
              "type": "equation_inline",
              "content": "20\\mu \\mathrm{l}5\\times \\mathrm{PCR}"
            }
          ]
        }
      ]
    },
    {
      "page_idx": 19,
      "blocks": [
        {
          "type": "page_number",
          "index": 0,
          "bbox": [
            0.157,
            0.054,
            0.19,
            0.067
          ],
          "content": [
            {
              "type": "text",
              "content": "178"
            }
          ]
        },
        {
          "type": "header",
          "index": 1,
          "bbox": [
            0.434,
            0.053,
            0.599,
            0.068
          ],
          "content": [
            {
              "type": "text",
              "content": "细胞生物学实验教程"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.124,
            0.088,
            0.909,
            0.171
          ],
          "content": [
            {
              "type": "text",
              "content": "缓冲液、8.5μl dNTP、1μl R-Bam-24、1μl 连接产物，在 72℃下静置3min来融化12-碱基寡聚体，加0.5μl Taq酶。在72℃下静置5min以便末端补平。循环20次:95℃1min，72℃3min。最后，将样品在72℃放置10min。用5μl在2.5%胶上检测。DNA拖尾痕迹在0.1~1kb部分应该可见。"
            }
          ],
          "continues_prev": true
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.125,
            0.174,
            0.911,
            0.321
          ],
          "content": [
            {
              "type": "text",
              "content": "实验必须进行阴性和阳性对照，这两种表型在质量和数量上应该具有相似的得率，如果 cDNA 的产出量很低，循环数目就一定要调整，增加 PCR 的循环数，从第 17 个循环开始，每 2 或 3 个循环后，在  "
            },
            {
              "type": "equation_inline",
              "content": "72^{\\circ}"
            },
            {
              "type": "text",
              "content": " C 的静置时取出  "
            },
            {
              "type": "equation_inline",
              "content": "5\\mu l"
            },
            {
              "type": "text",
              "content": " ，通过凝胶电泳检测产物。循环数目的增加会引起 DNA 拖痕亮度的加深，最终达到一个平台点。这个平台点的特征是，拖尾变狭窄或者产物变小，并且质量也在下降。每次差异表达都要选择一个合适的循环数目，即避免达到平台期，但是能有好的产量。用于一个 RDA 反应的两个表型在凝胶电泳中要比较相似。"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.126,
            0.324,
            0.912,
            0.47
          ],
          "content": [
            {
              "type": "text",
              "content": "（6）按照上面建立的方案，继续进行 PCR 反应以获得更多的材料。对于驱动子的准备，在 96 孔板的所有孔中分别进行  "
            },
            {
              "type": "equation_inline",
              "content": "100 \\mu l"
            },
            {
              "type": "text",
              "content": "  体系的反应。对于检测子的准备，由于只需要较少的材料，因此只需要进行 8 个反应就已经足够。进行这样批量的 PCR 反应时，应该先将酶、反应缓冲液和 DNA 进行混合，然后在分别分入每个孔中，并且要设立不含 DNA 的阴性对照。在大多数分析中，推荐进行交互实验，即每种 cDNA 分别用作驱动子和检测子。这样的话，一个 96 孔板中 DNA 的量就足够了。PCR 反应之后，在 2.5% 浓度的凝胶上电泳检测产物的差异个体数目。"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.128,
            0.473,
            0.914,
            0.641
          ],
          "content": [
            {
              "type": "text",
              "content": "（7）将96个驱动子（或8个检测子）的反应产物混合到一个管中，加等体积的苯酚/氯仿，强烈振荡。短暂离心以分相，将上清液转移到新的管中。如果分相有些浑浊，稍微对样品温热有助于分相清晰。重复抽提，加等体积的氯仿，再次振荡后，离心并收回上清液。一定要避免出现中间层，如果有必要的话，再重复抽提一次。加0.1体积的乙酸钠，等体积的预冷的异丙醇，混合并在-20℃沉淀20min，更长时间的静置可能会导致盐沉淀。高速离心（大于10 000g）15～30min，小心移去上清液，并用70%乙醇清洗沉淀。再次离心几分钟，移去乙醇，干燥沉淀（建议温度37℃，不要用真空）。取200μl T10重悬驱动子，取20μl T10重悬检测子，用荧光分光光度计检测其浓度。"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.129,
            0.644,
            0.914,
            0.747
          ],
          "content": [
            {
              "type": "text",
              "content": "（8）对于驱动子的准备，混合  "
            },
            {
              "type": "equation_inline",
              "content": "300\\mu g"
            },
            {
              "type": "text",
              "content": "  DNA、 "
            },
            {
              "type": "equation_inline",
              "content": "140\\mu l"
            },
            {
              "type": "text",
              "content": "  Dpn II 缓冲液、 "
            },
            {
              "type": "equation_inline",
              "content": "75\\mu l"
            },
            {
              "type": "text",
              "content": "  Dpn II 和水至总体积  "
            },
            {
              "type": "equation_inline",
              "content": "1400\\mu l"
            },
            {
              "type": "text",
              "content": " 。在  "
            },
            {
              "type": "equation_inline",
              "content": "37^{\\circ}C"
            },
            {
              "type": "text",
              "content": "  下静置 4h，并在  "
            },
            {
              "type": "equation_inline",
              "content": "65^{\\circ}C"
            },
            {
              "type": "text",
              "content": "  下 15min 以停止反应。用苯酚/氯仿抽提两次，氯仿抽提一次，并用预冷的异丙醇沉淀（参照前文）。用  "
            },
            {
              "type": "equation_inline",
              "content": "200\\mu l"
            },
            {
              "type": "text",
              "content": "  T10 溶解 DNA 并测其浓度。将消化后的驱动子稀释浓度至约  "
            },
            {
              "type": "equation_inline",
              "content": "600ng/\\mu l"
            },
            {
              "type": "text",
              "content": " ，测定其浓度之后精确稀释到  "
            },
            {
              "type": "equation_inline",
              "content": "500ng/\\mu l"
            },
            {
              "type": "text",
              "content": "  浓度。"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.13,
            0.75,
            0.915,
            0.833
          ],
          "content": [
            {
              "type": "text",
              "content": "（9）对于检测子的准备，混合  "
            },
            {
              "type": "equation_inline",
              "content": "10\\mu g"
            },
            {
              "type": "text",
              "content": "  DNA、 "
            },
            {
              "type": "equation_inline",
              "content": "10\\mu l"
            },
            {
              "type": "text",
              "content": "  Dpn II 缓冲液、 "
            },
            {
              "type": "equation_inline",
              "content": "5\\mu l"
            },
            {
              "type": "text",
              "content": "  Dpn II，加水至总体积为  "
            },
            {
              "type": "equation_inline",
              "content": "100\\mu l"
            },
            {
              "type": "text",
              "content": " 。在  "
            },
            {
              "type": "equation_inline",
              "content": "37^{\\circ}C"
            },
            {
              "type": "text",
              "content": "  下反应 2h， "
            },
            {
              "type": "equation_inline",
              "content": "65^{\\circ}C"
            },
            {
              "type": "text",
              "content": "  下 15min 后加  "
            },
            {
              "type": "equation_inline",
              "content": "500\\mu l"
            },
            {
              "type": "text",
