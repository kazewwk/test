              "content": " 溶液 "
            },
            {
              "type": "equation_inline",
              "content": "1.7\\mathrm{ml}"
            },
            {
              "type": "text",
              "content": "、"
            },
            {
              "type": "equation_inline",
              "content": "3\\mathrm{mol/LNaCl}"
            },
            {
              "type": "text",
              "content": " 溶液 "
            },
            {
              "type": "equation_inline",
              "content": "50\\mathrm{ml}"
            },
            {
              "type": "text",
