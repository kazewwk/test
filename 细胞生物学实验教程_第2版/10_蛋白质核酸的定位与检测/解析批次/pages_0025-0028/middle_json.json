              "type": "text",
              "content": " 咪唑。配 "
            },
            {
              "type": "equation_inline",
              "content": "100\\mathrm{ml}"
            },
            {
              "type": "text",
              "content": ", 加 "
            },
            {
              "type": "equation_inline",
              "content": "1\\mathrm{mol / LNaH_2PO_4}"
            },
            {
              "type": "text",
              "content": " 溶液 "
            },
            {
              "type": "equation_inline",
              "content": "4.66\\mathrm{ml}"
            },
            {
              "type": "text",
              "content": " 、 "
            },
            {
              "type": "equation_inline",
              "content": "1\\mathrm{mol / LNaH_2PO_4}"
            },
            {
              "type": "text",
