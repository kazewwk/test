              "type": "text",
              "content": "1. 溶液的配制"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.166,
            0.514,
            0.476,
            0.531
          ],
          "content": [
