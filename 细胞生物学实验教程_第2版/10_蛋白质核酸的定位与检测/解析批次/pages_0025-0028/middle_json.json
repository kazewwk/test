            {
              "type": "text",
              "content": "185"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.114,
            0.094,
            0.713,
            0.111
          ],
          "content": [
            {
              "type": "text",
              "content": "酸（大约 80ml）调节 pH 到 6.8，加蒸馏水定容至 1L，高压灭菌。"
            }
          ]
        },
        {
          "type": "text",
