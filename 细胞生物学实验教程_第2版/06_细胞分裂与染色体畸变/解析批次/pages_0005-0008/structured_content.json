                0.625,
                0.811,
                0.641
              ],
              "content": "（1）精原细胞，（2）细线期，（3）偶线期，（4）粗线期，（5）双线期，（6）终变期，"
            },
            {
              "bbox": [
                0.35,
                0.644,
                0.705,
                0.659
              ],
              "content": "(7) 中期 I，(8) 后期 I，(9) 精细胞，(10) 精子"
            }
          ],
