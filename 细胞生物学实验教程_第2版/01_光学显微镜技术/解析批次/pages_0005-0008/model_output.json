              0.595
            ]
          }
        ]
      },
      {
        "type": "text",
        "bbox": [
          0.126,
          0.602,
          0.911,
          0.665
        ],
        "content": [
          {
            "type": "text",
            "content": "暗视野显微镜能观察到 "
          },
          {
            "type": "equation_inline",
            "content": "0.004\\sim 0.2\\mu \\mathrm{m}"
          },
          {
            "type": "text",
            "content": " 的亚微颗粒，看到细胞在明视野照明下无法分辨的结构，但无法分辨物体的内部结构，因而它主要用来观察活细胞中微粒的运动，观察单细胞、硅藻、放线虫、细菌的线状结构，如纤维和鞭毛等。"
          }
        ],
        "lines": [
          {
            "bbox": [
              0.173,
              0.604,
              0.905,
              0.618
            ]
          },
          {
            "bbox": [
              0.132,
