        ],
        "content": [
          {
            "type": "text",
            "content": "细胞生物学实验教程"
          }
        ]
      },
      {
        "type": "paragraph_title",
        "bbox": [
          0.12,
          0.102,
          0.268,
          0.125
        ],
        "content": [
          {
            "type": "text",
            "content": "【实验目的】"
          }
        ],
        "lines": [
          {
            "bbox": [
              0.124,
