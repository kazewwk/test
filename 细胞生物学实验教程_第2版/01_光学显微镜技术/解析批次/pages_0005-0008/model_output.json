              0.88
            ]
          }
        ]
      },
      {
        "type": "text",
        "bbox": [
          0.166,
          0.884,
          0.913,
          0.904
        ],
        "content": [
          {
            "type": "text",
            "content": "(3) 使用时要严格按步骤操作, 熟悉显微镜各部件性能, 掌握粗、细调节钮的转动"
          }
        ],
        "lines": [
