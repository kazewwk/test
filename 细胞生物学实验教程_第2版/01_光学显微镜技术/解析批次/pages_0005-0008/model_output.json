            ]
          }
        ]
      },
      {
        "type": "paragraph_title",
        "bbox": [
          0.166,
          0.766,
          0.47,
          0.787
        ],
        "content": [
          {
            "type": "text",
            "content": "（四）使用显微镜的注意事项"
          }
        ],
        "lines": [
          {
            "bbox": [
              0.173,
              0.768,
              0.463,
              0.784
