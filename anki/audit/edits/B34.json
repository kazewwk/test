    {
      "id": "B34-069",
      "append_explanation": "图省略pri→pre的Drosha核处理和输出；70–90nt多指pre-miRNA而非pri的固定长度。",
      "image_ids": [
        "B34-I082"
      ]
    },
    {
      "id": "B34-070",
      "append_explanation": "完全配对仍需有切割活性的AGO，部分配对也可导致去腺苷化/降解，不只是翻译抑制。",
      "image_ids": [
        "B34-I060",
        "B34-I082"
      ]
    },
    {
      "id": "B34-071",
      "append_explanation": "独立siRNA、非靶对照及抗siRNA救援共同支持靶特异；敲低程度需RNA/蛋白双验证。",
      "image_ids": [
        "B34-I060"
      ]
    },
    {
      "id": "B34-072",
      "append_explanation": "同启动子、WT/突变UTR与互补恢复；RNA和蛋白同时测以定位降解与翻译贡献。",
      "image_ids": [
        "B34-I081",
        "B34-I082"
      ]
    },
    {
      "id": "B34-073",
      "append_explanation": "敲低一般不改DNA序列；染色质RNAi可改变表达状态，仍与DNA编辑不同。",
      "image_ids": [
        "B34-I060"
      ]
    },
    {
      "id": "B34-074",
      "append_explanation": "动物常以seed与局部配对识别，多目标还依UTR结构/可及性，不是任何含短序列都必被同等抑制。",
      "image_ids": [
        "B34-I082"
      ]
    },
    {
      "id": "B34-075",
      "append_explanation": "关键不仅去内含肽，还使两侧外显肽相接；发现经典为酵母Vma1而非最初古菌DNA聚合酶。",
      "image_ids": [
        "B34-I061"
      ]
    },
    {
      "id": "B34-076",
      "append_explanation": "酰基移位、支链转酯、末端Asn环化释放intein、S/O→N恢复肽键；图将若干子步骤合并，非简单水解再连接。",
      "image_ids": [
        "B34-I061"
      ]
    },
    {
      "id": "B34-077",
      "append_explanation": "Ub激活E1/转移E2后由E3选择底物；只有HECT/RBR等形成E3~Ub中间体，RING不需此共价步骤。",
      "image_ids": [
        "B34-I062",
        "B34-I063"
      ]
    },
    {
      "id": "B34-078",
      "append_explanation": "阻断IκB的特定降解信号会压低NFκB释放，但总NFκB量与核内转录活性要分开。",
      "image_ids": [
        "B34-I062",
        "B34-I063"
      ]
    },
    {
      "id": "B34-079",
      "append_explanation": "抑制蛋白酶体可同时积累激活因子/抑制物；20Sβ1/2/5位点及19S识别/解折叠分工，产物长度有分布。",
      "image_ids": [
        "B34-I062",
        "B34-I063"
      ]
    },
    {
      "id": "B34-080",
      "append_explanation": "多层反馈能维持状态但分化并非全部不可逆；不必每类细胞改写基因序列。",
      "image_ids": [
        "B34-I001",
        "B34-I055",
        "B34-I067"
      ]
    },
    {
      "id": "B34-081",
      "append_explanation": "联合新生RNA、前体/成熟比例与半衰期；RNA输出主要NXF1/NXT1通常不直接依Ran，不泛化所有输出。",
      "image_ids": [
        "B34-I001",
        "B34-I055"
      ]
    },
    {
      "id": "B30-079",
      "append_explanation": "图中RecA促进LexA自裂，RecA不是直接把LexA当底物剪开的普通蛋白酶。",
      "image_refs": [
        "B34-I045"
      ]
    },
    {
      "id": "B31-028",
      "append_explanation": "B34图对应现代fljB/fljA与fliC命名：Hin倒位含启动子的片段，FljA主要通过fliC mRNA抑制表达；图注误写fliA/fliB需纠正。",
      "image_refs": [
        "B34-I053",
        "B34-I054"
      ]
    }
  ],
