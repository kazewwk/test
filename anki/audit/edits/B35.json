    {
      "id": "B35-075",
      "append_explanation": "报告信号受转染、拷贝、活性/半衰期；同位点/内参并测新生RNA。",
      "image_ids": [
        "B35-I031"
      ]
    },
    {
      "id": "B35-076",
      "append_explanation": "植物基因型和培养决定再生，不是任一植物细胞都可直接长完整个体。",
      "image_ids": [
        "B35-I047"
      ]
    },
    {
      "id": "B35-077",
      "append_explanation": "高生长素促根/细胞分裂素促芽是常见模型，图流程缺具体激素量，不能据此强设固定配方。",
      "image_ids": [
        "B35-I047"
      ]
    },
    {
      "id": "B35-078",
      "append_explanation": "原生质体无壁需渗透压保护，长期培养可体细胞变异；叶盘法不必先去壁。",
      "image_ids": [
        "B35-I047"
      ]
    },
    {
      "id": "B35-079",
      "append_explanation": "加倍形成原单倍体同一套等位基因，注意非整倍/嵌合与来源。"
    },
    {
      "id": "B35-080",
      "append_explanation": "比较位点/拷贝和染色质；MAR可能减轻沉默，非保证消除位置效应。",
      "image_ids": [
        "B35-I047"
      ]
    },
    {
      "id": "B35-081",
      "append_explanation": "HAT需要TK及HGPRT等补救；氨基蝶呤抑DHFR导致从头嘌呤/dTMP受阻，非直接切DNA。"
    },
    {
      "id": "B35-082",
      "append_explanation": "嵌合个体未必生殖传递，必须后代验证改造ES是否进入生殖系。"
    },
    {
      "id": "B35-083",
      "append_explanation": "ES多能不是全能；SCNT多用去核未受精卵母细胞而非必须去核受精卵。"
    },
    {
      "id": "B35-084",
      "append_explanation": "替换mtDNA来源，不直接改核基因；残留/异质性需监测。"
    },
    {
      "id": "B35-085",
      "append_explanation": "同源臂效率依物种、路径与供体，25bp/14kb不当普适最优。"
    },
    {
      "id": "B35-086",
      "append_explanation": "两侧外内接头及随机整合/拷贝检测，供体内部阳性不定位。"
    },
    {
      "id": "B35-087",
      "append_explanation": "Cas9图省PAM与解链过程，配对不能替代PAM；各系统效率/脱靶依设计不能固定排序。",
      "image_ids": [
        "B35-I050"
      ]
    },
    {
      "id": "B35-088",
      "append_explanation": "图Cas9不是FokI二聚模型；ZFN/TALEN两側定位来自中文正文，避免用Cas9图误示二聚。",
      "image_ids": [
        "B35-I050"
      ]
    },
    {
      "id": "B35-089",
      "append_explanation": "一TALE重复识一碱基，12/13位RVD；正文“一个氨基酸两碱基”反了。"
    },
    {
      "id": "B35-090",
      "append_explanation": "NN兼G/A，偏好依重复邻域；不是全部模块绝对专一。"
    },
    {
      "id": "B35-091",
      "append_explanation": "图虚线为天然crRNA与tracrRNA工程连接，tracrRNA独立编码而非阵列重复简单产物。",
      "image_ids": [
        "B35-I050"
      ]
    },
    {
      "id": "B35-092",
      "append_explanation": "图未画PAM是省略，常用SpCas9 NGG依所用蛋白；不可推广所有Cas同规则。",
      "image_ids": [
        "B35-I050"
      ]
    },
    {
      "id": "B35-093",
      "append_explanation": "crRNA与图下链配对故HNH切下靶链，RuvC切上非靶链；野生型Cas9是双链切割酶。",
      "image_ids": [
        "B35-I050"
      ]
    },
    {
      "id": "B35-094",
      "append_explanation": "RNA定位切断后HDR/NHEJ等决定结果，双链断裂本身不保证敲除/精确修复。",
      "image_ids": [
        "B35-I050"
      ]
    },
    {
      "id": "B35-095",
      "append_explanation": "3bp缺失可能保框有功能；各等位与救援验证。",
      "image_ids": [
        "B35-I050"
      ]
    },
    {
      "id": "B35-096",
      "append_explanation": "独立编辑克隆+操作对照+救援分离目标因果和背景/脱靶。",
      "image_ids": [
        "B35-I050"
      ]
    },
    {
      "id": "B35-097",
      "append_explanation": "图有益点与有害方块是事后功能标注，突变本身不会预知好坏。",
      "image_ids": [
        "B35-I051"
      ]
    },
    {
      "id": "B35-098",
      "append_explanation": "库变异→目标选择→扩增形成循环；选择压力决定改善什么。",
      "image_ids": [
        "B35-I051",
        "B35-I052"
      ]
    },
    {
      "id": "B35-099",
      "append_explanation": "Taq错误率依条件，不能用一个每碱基值固定推所有轮次累积；过高损功能。",
      "image_ids": [
        "B35-I051"
      ]
    },
    {
      "id": "B35-100",
      "append_explanation": "随机片段重叠互作延伸可重组分离变异，外引物扩全长；不保证每组合都优于亲本。",
      "image_ids": [
        "B35-I051"
      ]
    },
    {
      "id": "B35-101",
      "append_explanation": "gp3/gp8融合+同颗粒DNA连接表型基因型，噬菌粒靠辅助装配，直接保留颗粒才能回收基因。",
      "image_ids": [
        "B35-I052"
      ]
    },
    {
      "id": "B35-102",
      "append_explanation": "支持物/无关蛋白负选，展示量/扩增速率也影响富集，游离目标竞争后再测本征结合。",
      "image_ids": [
        "B35-I052"
      ]
    },
    {
      "id": "B35-103",
      "append_explanation": "筛选更高残余活性须按初始活性归一化，不能从基因组合图直接证热稳定性。",
      "image_ids": [
        "B35-I051"
      ]
    },
    {
      "id": "B35-104",
      "append_explanation": "封未偶联5′OH阻止下一步跳碱基，固相化学通常3′→5′逐加；四唑为酸性活化剂不是弱碱催化。"
    },
    {
      "id": "B35-105",
      "append_explanation": "基因→表型反向遗传，表型→基因正向；DNA测序推序列不能代替实际剪接/蛋白修饰鉴定。",
      "image_ids": [
        "B35-I021"
      ]
    }
  ],
