  "new_cards": [
    {
      "id": "B05-G001",
      "front": "图5-16B的ESI质谱出现多个峰，为什么不能直接判断为多种蛋白或把m/z当作蛋白质量？",
      "core": "同一蛋白可获得不同数目的质子，形成多个电荷态；横轴为m/z。已知电荷数z时，M=z(m/z−H)，图中去卷积质量约29 kDa。",
      "criteria": [
        "说明同一蛋白的不同电荷态可产生多个峰",
        "区分m/z与M并写出换算关系"
      ],
      "image_ids": [
        "B05-I043"
      ],
      "source": "中文主干 §四（四）质谱法，图5-16",
      "extra": "例如标注+33的峰约为880.3，换算约29 kDa，而不是880 Da；图中数值经过取整，精确质量应由多个峰或去卷积确定。",
      "depth": "L2",
      "ability": "识图"
    },
    {
      "id": "B05-G002",
      "front": "ESI中相邻峰低m/z为x、高m/z为y，且相差一个电荷。高m/z峰的电荷数z及蛋白质量M如何求？",
      "core": "z=(x−H)/(y−x)，M=z(y−H)；H为质子质量约1.0073 Da。低m/z峰带z+1个电荷，高m/z峰带z个电荷。",
      "criteria": [
        "给出电荷数公式并区分两个峰的电荷态",
        "写出M的计算式"
      ],
      "image_ids": [],
      "source": "中文主干 §四（四）质谱法，L685–723；由相邻电荷态方程核算",
      "extra": "由(z+1)(x−H)=z(y−H)整理即可得到。原材料L720把分子写成y−H，会多算一个电荷，已按推导纠正。",
      "depth": "L3",
      "ability": "计算"
    }
